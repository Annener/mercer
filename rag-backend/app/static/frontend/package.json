{
  "name": "mercer-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mercer frontend — React + Vite + TS",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
